# Copy to .env and fill in. NEVER commit .env.
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
GITLAB_TOKEN=
# Local MySQL server and the first admin account. Never commit your real .env file.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=ci_failure_explainer
CI_ADMIN_USERNAME=
CI_ADMIN_EMAIL=
CI_ADMIN_PASSWORD=
# SMTP email delivery for email verification and password recovery OTPs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
# Random 32+ character secret for hashing OTP codes.
APP_OTP_SECRET=
# Model names change over time. Check your provider's current model list.
CI_EXPLAINER_MODEL=claude-haiku-5-5
# Prices in USD per 1,000,000 tokens, copied from your provider's pricing page.
CI_EXPLAINER_PRICE_IN=
CI_EXPLAINER_PRICE_OUT=
